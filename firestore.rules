rules_version = '2';

// กติกาความปลอดภัยของ Tourney Hub
// เอาไปวางที่ Firebase Console → Firestore Database → Rules → Publish
//
// หลักคิด:
// - ทัวร์ที่ตั้ง isPublic = true ใครก็อ่านได้ (widget ใน OBS ไม่ได้ล็อกอิน)
// - เขียนได้เฉพาะเจ้าของทัวร์เท่านั้น คนอื่นแก้ผลไม่ได้แม้เปิด devtools
// - ใบสมัครใครก็ส่งได้ถ้าล็อกอินแล้ว แต่แก้ได้เฉพาะเจ้าของทัวร์
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- ผู้ดูแลระบบ ----------
    // นี่คือคำตอบที่เชื่อได้จริงว่า "ใครเป็นแอดมิน" เพราะกติกาถูกบังคับที่ฝั่ง Google
    // ต่อให้แก้ localStorage หรือตัวแปรใน devtools ก็อ่านรายชื่อไม่ได้
    // และสร้างเอกสารสิทธิ์ให้ตัวเองไม่ได้ถ้ายังไม่ได้เป็นผู้ดูแลอยู่ก่อน
    //
    // ★★★ แก้อีเมลบรรทัดล่างเป็นบัญชี Google ที่คุณใช้ล็อกอินเว็บนี้ ★★★
    // บัญชีนี้เป็นผู้ดูแลทันทีโดยไม่ต้องสร้างเอกสารอะไรด้วยมือ
    // ใส่ได้หลายอีเมล คั่นด้วยจุลภาค เช่น ['a@gmail.com', 'b@gmail.com']
    function ownerEmails() {
       return ['phawit.ps@gmail.com', 'warissaramala@gmail.com'];
    }

    function isRootOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ownerEmails();
    }

    // ผู้ดูแลคนอื่นเพิ่มทีหลังได้จากหน้าเว็บ เก็บเป็นเอกสาร admins/{uid}
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (isRootOwner()
            || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    match /admins/{uid} {
      // เว็บเช็คสิทธิ์ด้วยการขออ่านทั้งคอลเลกชัน — ผ่าน = เป็นผู้ดูแล
      // วิธีนี้ทำให้เจ้าของเว็บใช้ได้เลยตั้งแต่ publish กติกา ไม่ต้องมีเอกสารก่อน
      allow list: if isAdmin();
      // อ่านเอกสารเดี่ยวได้เฉพาะของตัวเอง
      allow get: if request.auth != null && request.auth.uid == uid;
      // เพิ่มผู้ดูแลใหม่ได้เฉพาะผู้ดูแลที่มีอยู่แล้ว
      allow create, update: if isAdmin();
      // ถอดสิทธิ์คนอื่นได้ แต่ถอดตัวเองไม่ได้ กันล็อกตัวเองออกจนไม่เหลือใคร
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    /*
      ---------- โปรไฟล์ผู้ใช้ ----------
      มีไว้ให้เลือกคนจากรายชื่อตอนเพิ่มทีมงาน แทนการก๊อป uid มาวาง
      และผูกใบสมัครแข่งกับบัญชีจริง

      list เปิดให้เฉพาะผู้ดูแล ไม่งั้นใครสมัครบัญชีก็กวาดอีเมลทุกคนไปได้
      get เปิดให้คนที่ล็อกอินแล้ว เพราะต้องโชว์ชื่อเจ้าของทัวร์/ผู้สมัครแทนรหัสยาวๆ
      เขียนได้เฉพาะเจ้าของบัญชีตัวเอง และห้ามปลอม uid เป็นคนอื่น
    */
    match /users/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && (!('gameName' in request.resource.data)
            || request.resource.data.gameName.size() <= 40)
        && (!('contact' in request.resource.data)
            || request.resource.data.contact.size() <= 120);
      // ประวัติการสมัครผูกกับ uid นี้ ลบทิ้งแล้วข้อมูลเก่าจะกำพร้า
      allow delete: if false;
    }

    // ---------- ประวัติฝั่งคลาวด์ ----------
    // เขียนได้อย่างเดียว แก้หรือลบย้อนหลังไม่ได้เลย ประวัติถึงจะเชื่อถือได้
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.kind is string
        && request.resource.data.at is string;
      allow update, delete: if false;
    }

    // ---------- ลายนิ้วมือสลิปที่เคยใช้แล้ว ----------
    // เอกสารหนึ่งใบ = สลิปหนึ่งใบ id คือ SHA-256 ของ QR บนสลิป
    // สร้างได้อย่างเดียว เขียนทับไม่ได้ สลิปใบเดิมจึงส่งซ้ำไม่ได้
    // ต่อให้แก้โค้ดฝั่งเบราว์เซอร์ Firestore ก็ปฏิเสธที่เซิร์ฟเวอร์อยู่ดี
    match /slipRefs/{fingerprint} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if request.auth != null
        && fingerprint.size() == 64
        && request.resource.data.channelId is string;
      allow update: if false;
      allow delete: if isAdmin();
    }

    /*
      ---------- ช่อง (โปรไฟล์ผู้จัด + ระบบโดเนท/สมาชิก) ----------

      เจ้าของดูจากฟิลด์ ownerUid ในเอกสาร ไม่ใช่จากชื่อเอกสาร

      ของเดิมบังคับให้ชื่อเอกสารเท่ากับ uid ของเจ้าของ ซึ่งเท่ากับล็อกไว้ว่า
      หนึ่งบัญชีมีได้ช่องเดียวตลอดกาล เพราะชื่อเอกสารซ้ำกันไม่ได้
      ตอนนี้ชื่อเอกสารเป็นรหัสสุ่ม คนหนึ่งจึงเปิดได้หลายช่อง
      ช่องเก่าที่ชื่อเอกสารบังเอิญเท่ากับ uid ยังใช้ได้เหมือนเดิม
      เพราะมันมี ownerUid ตรงกันอยู่แล้ว
    */
    match /channels/{channelId} {
      function isChannelOwner() {
        return request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }
      // ตอนสร้างยังไม่มี resource ให้อ่าน ต้องดูจากของที่กำลังจะเขียนแทน
      function claimsChannel() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.ownerUid == request.auth.uid;
      }
      // ผู้ดูแลระบบเข้าไปจัดการได้ทุกช่อง ไม่ใช่แค่ช่องตัวเอง
      function canManageChannel() {
        return isChannelOwner() || isAdmin();
      }

      // ใครก็อ่านได้ หน้าโดเนทกับ widget ต้องใช้
      allow read: if true;

      // สร้างใหม่ได้ถ้าใส่ ownerUid เป็นตัวเอง
      allow create: if claimsChannel();

      // เจ้าของห้ามยกช่องให้คนอื่นด้วยการแก้ ownerUid ระหว่างทาง
      // ส่วนผู้ดูแลระบบแก้ของใครก็ได้ (ใช้ตอนช่วยตั้งค่าให้ผู้จัด)
      allow update: if (isChannelOwner() && claimsChannel()) || isAdmin();
      allow delete: if canManageChannel();

      match /donations/{donationId} {
        function isChannelOwner() {
          // ดูจาก ownerUid ของช่องแม่ ไม่ใช่ชื่อเอกสาร — คนหนึ่งมีได้หลายช่อง
          return request.auth != null
            && channel().ownerUid == request.auth.uid;
        }
        function canManageChannel() {
          return isChannelOwner() || isAdmin();
        }
        function channel() {
          return get(/databases/$(database)/documents/channels/$(channelId)).data;
        }

        // เจ้าของกับผู้ดูแลเห็นทุกใบ คนอื่นเห็นเฉพาะใบที่อนุมัติแล้ว (widget แจ้งเตือน)
        allow read: if canManageChannel() || resource.data.status == 'approved';

        /*
          ต้องล็อกอินก่อน (หน้าโดเนทล็อกอินแบบไม่ระบุตัวตนให้เอง)
          และเปิดรับเฉพาะตอนเจ้าของเปิดระบบไว้

          ★ ฟิลด์ "ผลตรวจ" ทุกตัวต้องล็อกไว้ตรงนี้ ★
          หน้าตั้งค่าของผู้จัดอนุมัติใบให้อัตโนมัติเมื่อเห็น slipCheck == 'verified'
          ถ้าไม่ล็อก คนส่งใบก็แค่แก้โค้ดหน้าเว็บให้เขียน 'verified' มาตั้งแต่แรก
          แล้วใบปลอมจะขึ้นจอสตรีมเองโดยไม่มีสลิปจริงสักใบ
          ค่าพวกนี้เป็นของ Worker ที่ตรวจกับธนาคารแล้วเท่านั้น (เขียนผ่าน update)

          เขียนเป็น "ไม่มีฟิลด์ก็ได้ แต่ถ้ามีต้องเป็นค่านี้" เพื่อให้หน้าเว็บรุ่นเก่า
          ที่ยังค้างอยู่บนเครื่องคนอื่นส่งใบได้ตามปกติระหว่างรอ deploy รอบใหม่
        */
        allow create: if request.auth != null
          && (channel().donate.enabled == true || channel().member.enabled == true)
          && request.resource.data.status == 'pending'
          && request.resource.data.kind in ['tip', 'member']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.message.size() <= 140
          && (request.resource.data.slip == null
              || request.resource.data.slip.size() <= 400000)
          // ผลตรวจจากธนาคารยังไม่เกิด ณ ตอนสร้างใบ อย่างมากได้แค่ "อ่าน QR ได้ ไม่ซ้ำ"
          && (!('slipCheck' in request.resource.data)
              || request.resource.data.slipCheck in ['none', 'unique'])
          && (!('autoApproved' in request.resource.data)
              || request.resource.data.autoApproved == false)
          && (!('slipAmount' in request.resource.data)
              || request.resource.data.slipAmount == null)
          && (!('slipAt' in request.resource.data)
              || request.resource.data.slipAt == null)
          && (!('slipBank' in request.resource.data)
              || request.resource.data.slipBank == null)
          // วันหมดอายุสมาชิกคิดตอนอนุมัติ ไม่ใช่ตอนสมัคร
          && (!('expiresAt' in request.resource.data)
              || request.resource.data.expiresAt == null)
          // ปลอมเป็นคนอื่นไม่ได้ — ใบที่โดนสแปมจะได้ตามรอยกลับไปที่บัญชีต้นทางได้
          && (!('byUid' in request.resource.data)
              || request.resource.data.byUid == request.auth.uid);

        allow update, delete: if canManageChannel();
      }

      /*
        ---------- คิวขอเพลง ----------
        คิวต้องเปิดให้อ่านสาธารณะ เพราะ widget ใน OBS ไม่ได้ล็อกอิน
        และคนขอเพลงอยากเห็นว่าคิวถึงไหนแล้วโดยไม่ต้องสมัครอะไร
        ในเอกสารไม่มีข้อมูลติดต่อ มีแค่ชื่อที่คนขอพิมพ์เอง จึงเปิดอ่านได้

        คนขอสร้างได้อย่างเดียว แก้สถานะไม่ได้ ไม่งั้นก็ดันเพลงตัวเองขึ้นเป็น
        "กำลังเล่น" ได้เอง — การจัดคิวเป็นสิทธิ์ของเจ้าของช่องกับผู้ดูแลเท่านั้น
      */
      match /songRequests/{songId} {
        function isChannelOwner() {
          // ดูจาก ownerUid ของช่องแม่ ไม่ใช่ชื่อเอกสาร — คนหนึ่งมีได้หลายช่อง
          return request.auth != null
            && channel().ownerUid == request.auth.uid;
        }
        function canManageChannel() {
          return isChannelOwner() || isAdmin();
        }
        function channel() {
          return get(/databases/$(database)/documents/channels/$(channelId)).data;
        }

        allow read: if true;

        // ต้องล็อกอินก่อน (หน้าขอเพลงล็อกอินแบบไม่ระบุตัวตนให้เอง)
        // และเปิดรับเฉพาะตอนเจ้าของช่องเปิดระบบไว้
        allow create: if request.auth != null
          && channel().songs.enabled == true
          && request.resource.data.status == 'queued'
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.videoId is string
          && request.resource.data.videoId.size() == 11
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 140
          && request.resource.data.byName is string
          && request.resource.data.byName.size() > 0
          && request.resource.data.byName.size() <= 40
          && (request.resource.data.message == null
              || request.resource.data.message.size() <= 120);

        // จัดคิว (เปลี่ยนสถานะ/เลื่อนลำดับ) ทำได้เฉพาะเจ้าของช่องกับผู้ดูแล
        allow update: if canManageChannel();

        /*
          ถอนเพลงของตัวเอง — คนขอลบใบของตัวเองได้เฉพาะตอนที่ยังรอคิวอยู่

          ห้ามลบตอนเพลงกำลังเล่น เพราะจะดึงเพลงหายไปกลางไลฟ์
          และห้ามลบใบที่เล่นจบแล้ว เพราะเป็นประวัติที่สตรีมเมอร์ใช้ดูย้อนหลัง
          (เทียบ byUid กับคนที่กดอยู่ คนอื่นจึงลบของเราไม่ได้)
        */
        allow delete: if canManageChannel()
          || (request.auth != null
              && resource.data.byUid == request.auth.uid
              && resource.data.status == 'queued');
      }
    }

    /*
      ---------- ต้นฉบับของทัวร์ (ที่ทำงานจริง) ----------
      แยกจาก tournaments เพราะ tournaments เปิดให้อ่านสาธารณะเมื่อ isPublic
      (widget ใน OBS กับลิงก์แชร์ไม่ได้ล็อกอิน) ถ้าเก็บของทุกอย่างไว้ที่เดียว
      เบอร์ติดต่อทีมกับ PIN ผู้จัดจะหลุดตามไปด้วย

      drafts จึงเก็บข้อมูลเต็มและไม่เปิดสาธารณะเด็ดขาด
      ส่วน tournaments เก็บสำเนาที่ตัดข้อมูลติดต่อออกแล้วไว้ให้คนนอกดู
    */
    match /drafts/{draftId} {
      function draftOwner() {
        return request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }
      function draftStaff() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.adminEmails is list
          && request.auth.token.email.lower() in resource.data.adminEmails;
      }

      allow read: if draftOwner() || draftStaff() || isAdmin();
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if draftOwner() || draftStaff() || isAdmin();
      allow delete: if draftOwner() || isAdmin();
    }

    match /tournaments/{tournamentId} {
      function isOwner() {
        return request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      }
      function claimsOwnership() {
        return request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
      }
      // ทีมงานที่เจ้าของเพิ่มอีเมลไว้ ต้องเป็นอีเมลที่ยืนยันแล้วเท่านั้น
      // (ล็อกอินแบบไม่ระบุตัวตนไม่มี email ใน token เลยผ่านตรงนี้ไม่ได้)
      function isStaff() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.adminEmails is list
          && request.auth.token.email.lower() in resource.data.adminEmails;
      }
      // ทีมงานห้ามยกระดับตัวเอง: เปลี่ยนเจ้าของหรือแก้รายชื่อทีมงานไม่ได้
      function keepsAccessFields() {
        return request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.adminEmails == resource.data.adminEmails;
      }

      allow read: if resource.data.isPublic == true || isOwner() || isStaff() || isAdmin();

      // สร้างใหม่ได้ถ้าใส่ ownerUid เป็นตัวเอง
      allow create: if claimsOwnership();

      // เจ้าของกับผู้ดูแลระบบแก้ได้ทุกอย่าง ทีมงานแก้ได้ทุกอย่างยกเว้นสิทธิ์
      allow update: if (isOwner() && claimsOwnership())
        || isAdmin()
        || (isStaff() && keepsAccessFields());

      // ลบได้เฉพาะเจ้าของกับผู้ดูแลระบบ
      allow delete: if isOwner() || isAdmin();

      match /registrations/{registrationId} {
        function tournament() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        function isTournamentOwner() {
          return request.auth != null
            && tournament().ownerUid == request.auth.uid;
        }
        // ทีมงานอนุมัติใบสมัคร/สลิปได้เหมือนเจ้าของ
        function isTournamentStaff() {
          return request.auth != null
            && request.auth.token.email_verified == true
            && tournament().adminEmails is list
            && request.auth.token.email.lower() in tournament().adminEmails;
        }
        function canManage() {
          return isTournamentOwner() || isTournamentStaff() || isAdmin();
        }

        /*
          ต้องให้ทีมงานกับผู้ดูแลระบบ "อ่าน" ได้ด้วย ไม่ใช่แค่ "แก้"
          ของเดิมเปิดแค่เจ้าของ ทีมงานจึงอนุมัติได้แต่มองไม่เห็นว่ามีใบอะไรให้อนุมัติ
          ซึ่งเท่ากับอนุมัติไม่ได้จริง
        */
        allow read: if canManage()
          || (request.auth != null && resource.data.byUid == request.auth.uid);

        // ล็อกอินแล้วสมัครได้ ต้องส่งชื่อทีมมาด้วย และสถานะเริ่มต้นต้องเป็น pending
        allow create: if request.auth != null
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.teamName is string
          && request.resource.data.teamName.size() > 0
          && request.resource.data.teamName.size() <= 40
          && request.resource.data.members.size() <= 12;

        // อนุมัติ/ปฏิเสธ ทำได้เฉพาะเจ้าของทัวร์
        allow update: if canManage();

        /*
          ถอนใบ — ผู้จัดลบได้เสมอ ส่วนเจ้าของใบถอนเองได้เฉพาะตอนที่ยังไม่ถูกตัดสิน
          ถ้าปล่อยให้ถอนหลังอนุมัติแล้ว ทีมจะหายจากสายที่จับไปแล้วโดยผู้จัดไม่รู้ตัว
        */
        allow delete: if canManage()
          || (request.auth != null
              && resource.data.byUid == request.auth.uid
              && resource.data.status == 'pending');
      }

    }
  }
}
