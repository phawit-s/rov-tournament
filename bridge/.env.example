# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่า —  .env ห้าม commit ขึ้น git
# (มี INGEST_TOKEN อยู่ในนั้น ใครได้ไปก็ยัดเพลงเข้าคิวช่องเราได้)

# ชื่อผู้ใช้ TikTok ของคนที่ไลฟ์ ไม่ต้องใส่ @
TIKTOK_USER=your_tiktok_name

# ลิงก์ Worker ตัวเดียวกับที่ใช้ตรวจสลิป/ค้นเพลง
WORKER_URL=https://slip-verify.xxxx.workers.dev

# ต้องตรงกับที่ตั้งไว้ใน Worker ด้วย wrangler secret put INGEST_TOKEN
INGEST_TOKEN=

# ช่องปลายทาง — ใส่ handle ของช่อง (ตัวที่อยู่ในลิงก์หน้าขอเพลง /song/#h=xxx)
# หรือจะใส่ไอดีเอกสารของช่องก็ได้ ระบบหาให้ทั้งสองแบบ
CHANNEL=

# คำสั่งที่คนดูต้องพิมพ์นำหน้า คั่นด้วยจุลภาค (ตัวพิมพ์เล็ก/ใหญ่ไม่สำคัญ)
COMMANDS=!เพลง,!ขอเพลง,!song,!sr

# คนหนึ่งขอได้ทุกๆ กี่วินาที — 0 = ไม่หน่วง
# ตัวนี้ช่วยประหยัดโควตาค้นหา YouTube (ฟรีวันละ ~100 ครั้งเท่านั้น)
COOLDOWN_SEC=45

# คีย์ของบริการลายเซ็น (ไม่ใส่ก็ได้ ใช้โควตาสาธารณะซึ่งจำกัดกว่า)
# ขอได้ที่ https://www.eulerstream.com — จำเป็นเมื่อไลฟ์คนดูเยอะหรือโดนปฏิเสธบ่อย
SIGN_API_KEY=
