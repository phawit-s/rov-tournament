# ค่าเชื่อมต่อ Firebase — คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
# หาได้ที่ Firebase Console → Project settings → General → Your apps → Web app → SDK setup
#
# key พวกนี้เป็นค่าสาธารณะ ปลอดภัยที่จะอยู่ในโค้ดฝั่ง client
# ตัวคุมสิทธิ์จริงคือ firestore.rules
#
# ถ้าไม่ตั้งค่า เว็บจะทำงานแบบออฟไลน์ (เก็บใน localStorage) ได้ตามปกติ

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
